# Keep the build context to what the image needs. Never send secrets or local state.

# VCS, CI, editors, assistants
.git
.github
.codex
.claude
.agents
.vscode
.idea
.fleet
.zed

# Secrets and local environment
.env
.env.*
!.env.example
auth.json

# Dependencies and build output (rebuilt inside the image)
node_modules
vendor
public/build
public/hot
public/storage
public/fonts-manifest.dev.json
bootstrap/ssr

# Wayfinder output is generated during the Vite build (gitignored)
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Local runtime state
storage/app/private/*
storage/app/public/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php
database/*.sqlite
.phpunit.cache
.phpunit.result.cache

# Not needed at runtime
tests
docs
*.md
Dockerfile
.dockerignore
